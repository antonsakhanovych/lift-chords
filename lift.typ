// Лифт — текст песни с аккордами
// Формат по примеру examples/zombie.typ из пакета conchord:
// https://github.com/sitandr/conchord
//
// Как добавлять аккорды:
//   Пиши аккорд в квадратных скобках прямо перед словом, над которым
//   он должен стоять — пакет сам разберет обозначение и подрисует
//   диаграмму зажима в библиотеку аккордов справа сверху.
//
//     [Am] Выхожу я [F] из подъезда, в лифте было очень тесно.
//
//   Строку без аккордов пиши как обычный текст. Каждую лирическую
//   строку заканчивай `\`, чтобы она не сливалась со следующей.
//
//   Названия разделов оборачивай в #raw(), иначе квадратные скобки
//   в "[[Куплет 1]]" пакет попытается разобрать как аккорд:
//
//     === #raw("[[Куплет 1]]")

#import "@preview/conchord:0.4.0": chordify, sized-chordlib, overchord, shift-chord-tonality

#let transpose = int(sys.inputs.at("transpose", default: "0"))
#let web = sys.inputs.at("web", default: "false") == "true"
#let transposed-chord(name) = overchord(shift-chord-tonality(name, transpose))

#set page(
  paper: "a4",
  margin: (x: 2.2cm, y: 2cm),
  height: if web { auto } else { 29.7cm },
)

#set text(
  font: "Liberation Serif",
  size: 12pt,
  lang: "ru",
)

#let laq = sym.quote.chevron.l
#let raq = sym.quote.chevron.r

#show: chordify.with(line-chord: transposed-chord)

#h(1fr)#box[
  #set align(center)
  = Лифт
  #text(size: 10pt, style: "italic")[Варя Пипко]
]#h(5fr)

#place(right, dx: -1em, {
  set align(left)
  show text: strong
  sized-chordlib(width: 110pt)
})

=== #raw("[[Куплет 1]]")

Выхо[Am] жу я из подъезда, в лифте было очень тесно. \
Все ку[C] да-то бегут, видно, где-то их ждут. \
Ну а [D] если по приколу подойти спросить любого: \
#(laq)Эй, со[F] сед, ну как дела? За Зе[F] нит или ЦС[G] КА?#raq

